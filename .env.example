# Groq (https://console.groq.com/keys) — free tier, no credit card, used
# here for prototyping. Swap these three values for any other
# OpenAI-compatible endpoint (including an org's own) in production; no code
# change is required.

LLM_API_KEY=gsk_your_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Max Flesch-Kincaid grade level the draft may score. 6 is the NIH/AMA/HHS
# consensus standard for patient materials — see
# service/verifier/reading_level.py for why this isn't raised to match
# current model performance.
READING_LEVEL_MAX_GRADE=6
