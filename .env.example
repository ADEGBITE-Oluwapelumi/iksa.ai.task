# GitHub Models (https://models.github.ai/inference) — free/prototyping-only,
# rate-limited. Swap these three values for an org's own OpenAI-compatible
# endpoint in production; no code change is required.

# A GitHub personal access token with the "models" permission.
GITHUB_MODELS_TOKEN=ghp_your_token_here

GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Max Flesch-Kincaid grade level the draft may score (issue default: 6).
READING_LEVEL_MAX_GRADE=6
